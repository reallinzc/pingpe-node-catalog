{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pingpe-node-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat_v2"],
  "workers_dev": true,
  "browser": {
    "binding": "BROWSER"
  },
  "kv_namespaces": [
    {
      "binding": "STATE"
    }
  ],
  "triggers": {
    "crons": ["30 20 * * SUN"]
  },
  "vars": {
    "PINGPE_TARGET": "191.223.216.145",
    "GITHUB_OWNER": "reallinzc",
    "GITHUB_REPO": "pingpe-node-catalog",
    "GITHUB_BRANCH": "main",
    "GITHUB_DATA_PATH": "data/pingpe-nodes.json",
    "MIN_NODE_COUNT": "120"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
